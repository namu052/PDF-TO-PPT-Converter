# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=8192

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# PDF limits
MAX_PDF_SIZE_MB=50
MAX_SLIDES=50
RENDER_DPI=200

# Job management
OUTPUT_DIR=./output
JOB_TTL_HOURS=24
AUTO_SAVE_INTERVAL_SEC=30

# OCR
MIN_REGION_PCT=1.0
OCR_TIMEOUT_SEC=15

# PPTX defaults (inches)
DEFAULT_SLIDE_WIDTH=13.333
DEFAULT_SLIDE_HEIGHT=7.5
